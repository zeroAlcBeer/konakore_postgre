# Makefile for managing the development and deployment lifecycle

# Load local overrides if exists (not tracked by git)
# Copy Makefile.local.example to Makefile.local and fill in your values
-include Makefile.local

# --- Variables ---
# Your private registry URL. Can be overridden e.g., `make push REGISTRY_URL=my.registry.com`
REGISTRY_URL ?= 192.168.0.110:5000

# Compose command (v2 plugin syntax; docker-compose v1 is not installed on the pi)
COMPOSE ?= docker compose

# Service names used in docker-compose
API_SERVICE_NAME := api
WORKER_SERVICE_NAME := worker
FRONTEND_SERVICE_NAME := frontend

# Image names in your private registry
API_IMAGE_NAME := my-konakore-api
WORKER_IMAGE_NAME := my-konakore-worker
FRONTEND_IMAGE_NAME := my-konakore-frontend

# Immutable tag derived from git HEAD.
GIT_SHA := $(shell git rev-parse --short=12 HEAD 2>/dev/null)

# Project name derived from the current directory, used by docker-compose
PROJECT_NAME := $(shell basename $(CURDIR))

# Final image names generated by docker-compose (e.g., konakore_postgre_api)
LOCAL_API_IMAGE := $(PROJECT_NAME)_$(API_SERVICE_NAME)
LOCAL_WORKER_IMAGE := $(PROJECT_NAME)_$(WORKER_SERVICE_NAME)
LOCAL_FRONTEND_IMAGE := $(PROJECT_NAME)_$(FRONTEND_SERVICE_NAME)


# --- Local Development ---
.PHONY: build up down restart logs logs-api logs-worker logs-frontend build-frontend local uv-lock doctor

# Generate uv.lock file for the Python API service (run this before building)
uv-lock:
	@echo "--> Generating uv.lock file for the Python API service..."
	cd api && uv lock

# Build the custom docker images for api, worker, and frontend
build:
	@echo "--> Building local Docker images..."
	$(COMPOSE) build

# Build only the frontend image
build-frontend:
	@echo "--> Building frontend Docker image..."
	$(COMPOSE) build frontend

# Start frontend locally against the remote API on pi.
# Uses frontend/.env (VITE_API_TARGET); copies from .env.example if missing.
local:
	@echo "--> Starting frontend locally (API via frontend/.env)..."
	@if [ ! -f frontend/.env ]; then \
		echo "    frontend/.env not found, copying from .env.example..."; \
		cp frontend/.env.example frontend/.env; \
	fi
	@echo "    VITE_API_TARGET=$$(grep -E '^VITE_API_TARGET=' frontend/.env | cut -d= -f2-)"
	cd frontend && npm run dev

# Start all services in detached mode
up:
	@echo "--> Starting all services..."
	$(COMPOSE) up -d

# Stop and remove all services
down:
	@echo "--> Stopping all services..."
	$(COMPOSE) down

# Restart all services
restart: down up

# Tail logs from all services
logs:
	@echo "--> Tailing logs for all services..."
	$(COMPOSE) logs -f

# Tail logs for the api service
logs-api:
	@echo "--> Tailing logs for the api service..."
	$(COMPOSE) logs -f api

# Tail logs for the worker service
logs-worker:
	@echo "--> Tailing logs for the worker service..."
	$(COMPOSE) logs -f worker

# Tail logs for the frontend service
logs-frontend:
	@echo "--> Tailing logs for the frontend service..."
	$(COMPOSE) logs -f frontend

# Run react-doctor to check React codebase health (100/100 target)
doctor:
	@echo "--> Running react-doctor on frontend/..."
	cd frontend && npx react-doctor .


# --- Deployment ---
.PHONY: release-component release-api release-worker release-frontend release-all

# Build and publish one independently deployable component, tagged both
# :latest and :$(GIT_SHA). Prefer the release-{api,worker,frontend} aliases
# instead of calling this target directly.
release-component:
	@if [ -z "$(GIT_SHA)" ]; then echo "Error: not in a git repo"; exit 1; fi
	@if [ -z "$(COMPONENT)" ]; then echo "Error: COMPONENT is required"; exit 1; fi
	@if ! git diff-index --quiet HEAD --; then \
		echo "Warning: working tree dirty — :$(GIT_SHA) will NOT represent committed state"; \
	fi
	@set -eu; \
	case "$(COMPONENT)" in \
		api)      LOCAL="$(LOCAL_API_IMAGE)";      REMOTE="$(API_IMAGE_NAME)" ;; \
		worker)   LOCAL="$(LOCAL_WORKER_IMAGE)";   REMOTE="$(WORKER_IMAGE_NAME)" ;; \
		frontend) LOCAL="$(LOCAL_FRONTEND_IMAGE)"; REMOTE="$(FRONTEND_IMAGE_NAME)" ;; \
		*) echo "Error: unsupported COMPONENT=$(COMPONENT)"; exit 1 ;; \
	esac; \
	$(COMPOSE) build $(COMPONENT); \
	echo "--> Publishing $$REMOTE @ $(GIT_SHA)"; \
	docker tag  "$$LOCAL:latest" "$(REGISTRY_URL)/$$REMOTE:latest"; \
	docker tag  "$$LOCAL:latest" "$(REGISTRY_URL)/$$REMOTE:$(GIT_SHA)"; \
	docker push "$(REGISTRY_URL)/$$REMOTE:latest"; \
	docker push "$(REGISTRY_URL)/$$REMOTE:$(GIT_SHA)"; \
	TAG_VAR="$$(echo "$(COMPONENT)" | tr '[:lower:]' '[:upper:]')_TAG"; \
	echo "--> Next on pi: set $$TAG_VAR=$(GIT_SHA) in /opt/stacks/konakore_postgre/.env, then compose pull/up"

release-api:
	@$(MAKE) release-component COMPONENT=api --no-print-directory

release-worker:
	@$(MAKE) release-component COMPONENT=worker --no-print-directory

release-frontend:
	@$(MAKE) release-component COMPONENT=frontend --no-print-directory

# Release every component at the current git SHA
release-all: release-api release-worker release-frontend


# --- Help ---
.PHONY: help

# Display this help message
help:
	@echo "Usage: make [target]"
	@echo ""
	@echo "Local Development:"
	@echo "  uv-lock        Generate uv.lock file for the Python API service"
	@echo "  build          Build Docker images for api, worker, and frontend"
	@echo "  build-frontend Build only the frontend Docker image"
	@echo "  local          Start frontend locally, proxy API to pi via frontend/.env"
	@echo "  up             Start services in detached mode"
	@echo "  down           Stop and remove services"
	@echo "  restart        Restart all services"
	@echo "  logs           Tail logs from all services"
	@echo "  logs-api       Tail logs from the api service"
	@echo "  logs-worker    Tail logs from the worker service"
	@echo "  logs-frontend  Tail logs from the frontend service"
	@echo "  doctor         Run react-doctor to check React codebase health"
	@echo ""
	@echo "Deployment:"
	@echo "  release-api      Build + push the api image (:latest and :git-sha)"
	@echo "  release-worker   Build + push the worker image (:latest and :git-sha)"
	@echo "  release-frontend Build + push the frontend image (:latest and :git-sha)"
	@echo "  release-all      Release every component at the current git SHA"
	@echo ""
	@echo "Environment Variables:"
	@echo "  REGISTRY_URL   Private registry URL (default: 192.168.0.110:5000)"
