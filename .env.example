# Copy to .env (gitignored). On the pi this lives next to the stack's
# compose file at /opt/stacks/konakore_postgre/.env.

# ─── Private registry ────────────────────────────────────────────────────────
REGISTRY_URL=192.168.0.110:5000

# ─── Production image versions ───────────────────────────────────────────────
# Pin each component to an immutable git-SHA tag (published by
# `make release-<component>`); use `latest` only for local experiments.
API_TAG=latest
WORKER_TAG=latest
FRONTEND_TAG=latest

# ─── Postgres ────────────────────────────────────────────────────────────────
POSTGRES_USER=konakore
POSTGRES_PASSWORD=secret
POSTGRES_DB=konakore

# ─── aria2 RPC (worker downloads) ────────────────────────────────────────────
ARIA2_URL=ws://192.168.0.110:6800/jsonrpc
ARIA2_SECRET=

# ─── API CORS (optional) ─────────────────────────────────────────────────────
# Production traffic is same-origin through the nginx proxy, so this is only
# needed for non-proxied dev access. Comma-separated origins.
#CORS_ORIGINS=http://localhost:5173

# ─── Konachan.com backfill (explicit/questionable posts) ─────────────────────
# konachan.net is safe-only now, so rating:q / rating:e posts must be fetched
# from konachan.com, which sits behind Cloudflare. The worker's range-backfill
# task replays a browser-issued cf_clearance cookie plus moebooru credentials.
#
# How to obtain the values:
#   1. Log in to https://konachan.com in a browser, solve any CF challenge.
#   2. DevTools -> Application -> Cookies -> konachan.com -> copy `cf_clearance`.
#   3. DevTools -> Network -> any request -> copy the exact `User-Agent`.
# cf_clearance is tied to the requesting IP + UA and expires; refresh it (and
# restart the worker) when the task starts erroring with "cf_clearance expired".
#
# Provide either KONACHAN_PASSWORD (the worker derives the salted SHA1) or a
# precomputed KONACHAN_PASSWORD_HASH.
KONACHAN_LOGIN=
KONACHAN_PASSWORD=
#KONACHAN_PASSWORD_HASH=
KONACHAN_CF_CLEARANCE=
KONACHAN_USER_AGENT=

# range-backfill tuning (defaults shown). Interval accepts Go durations (e.g.
# 90s, 2m, 5m). START_ID is where konachan.net went safe-only (the gap start).
RANGE_BACKFILL_INTERVAL=2m
RANGE_BACKFILL_START_ID=404000
RANGE_BACKFILL_WINDOW=100
