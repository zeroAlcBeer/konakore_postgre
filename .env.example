# Copy to .env (gitignored). On the pi this lives next to the stack's
# compose file at /opt/stacks/konakore_postgre/.env.

# ─── Private registry ────────────────────────────────────────────────────────
REGISTRY_URL=192.168.0.110:5000

# ─── Production image versions ───────────────────────────────────────────────
# Pin each component to an immutable git-SHA tag (published by
# `make release-<component>`); use `latest` only for local experiments.
API_TAG=latest
WORKER_TAG=latest
FRONTEND_TAG=latest

# ─── Postgres ────────────────────────────────────────────────────────────────
POSTGRES_USER=konakore
POSTGRES_PASSWORD=secret
POSTGRES_DB=konakore

# ─── aria2 RPC (worker downloads) ────────────────────────────────────────────
ARIA2_URL=ws://192.168.0.110:6800/jsonrpc
ARIA2_SECRET=

# ─── API CORS (optional) ─────────────────────────────────────────────────────
# Production traffic is same-origin through the nginx proxy, so this is only
# needed for non-proxied dev access. Comma-separated origins.
#CORS_ORIGINS=http://localhost:5173
